# 복사해서 .env 로 만들고 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# Claude API 키 (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Google 스프레드시트 ID (시트 URL의 /d/ 와 /edit 사이 문자열)
GOOGLE_SHEET_ID=

# 서비스 계정 JSON 파일 경로 (프로젝트 루트에 두세요)
GOOGLE_CREDENTIALS_FILE=credentials.json

# 1 이면 API 키가 있어도 강제로 Mock 모드로 동작
FORCE_MOCK=0
