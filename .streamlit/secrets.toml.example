# Streamlit Community Cloud 배포용 설정 예시.
#
# 이 파일을 복사해 secrets.toml 로 만들면 로컬에서도 동작하지만,
# 로컬은 .env 를 쓰는 편이 간단합니다 (.env 가 우선 적용됩니다).
#
# 배포할 때는 이 파일을 올리지 말고, Streamlit Cloud 화면에서
#   앱 → Settings → Secrets
# 에 아래 내용을 붙여넣으세요.

ANTHROPIC_API_KEY = "sk-ant-..."
GOOGLE_SHEET_ID = "스프레드시트 ID"

# 공개 데모의 AI 호출 상한. 0 이면 제한 없음 (공개 앱에서는 권하지 않습니다).
QUOTA_PER_SESSION = "10"
QUOTA_PER_DAY = "200"

# 서비스 계정 JSON 전체를 한 줄 문자열로. 줄바꿈은 \n 으로 이스케이프된 상태 그대로 둡니다.
# credentials.json 파일 내용을 그대로 복사해 아래 삼중 따옴표 안에 넣으세요.
GOOGLE_CREDENTIALS_JSON = '''
{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
'''
